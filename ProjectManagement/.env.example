# Database Configuration
POSTGRES_DB=ProjectManagement
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here

# Backend Security & JWT
JWT_SECRET=your_base64_jwt_secret_here
JWT_EXPIRATION=43200000

# CORS Allowed Origins (Comma-separated or * for public APIs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.vercel.app

# Frontend Backend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8080
